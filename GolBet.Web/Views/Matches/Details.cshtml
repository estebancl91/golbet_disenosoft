@model GolBet.Services.DTOs.MatchDetailDto
@using GolBet.Entities.Enums
@using GolBet.Repositories.Data

@{
    ViewData["Title"] = $"Detalle: {Model.HomeTeamName} vs {Model.AwayTeamName}";
}

<div class="container py-4">
    <!-- Mensajes de feedback -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Encabezado del Partido -->
    <div class="card shadow-sm mb-4">
        <div class="card-body text-center py-4">
            <span class="badge bg-primary mb-2">@Model.Status</span>
            <div class="row align-items-center">
                <div class="col-5">
                    <h3 class="fw-bold">@Model.HomeTeamName</h3>
                </div>
                <div class="col-2 text-muted fw-bold fs-4">VS</div>
                <div class="col-5">
                    <h3 class="fw-bold">@Model.AwayTeamName</h3>
                </div>
            </div>
            <p class="text-muted mt-3 mb-1">
                📅 Fecha: @Model.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>
    </div>

    <!-- Panel de Apuestas -->
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <div class="card border-warning text-center p-4">
                    <h5>¿Deseas apostar en este encuentro?</h5>
                    <p class="text-muted">Inicia sesión con tu cuenta de apostador para participar.</p>
                    <div>
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Iniciar Sesión</a>
                    </div>
                </div>
            }
            else if (User.IsInRole(DbSeeder.AdminRole))
            {
                <div class="alert alert-secondary text-center">
                    <p class="mb-3">ℹ️ Vista de Administrador: Los administradores gestionan cuotas y resultados, no realizan apuestas.</p>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-bold">
                        Editar Cuotas
                    </a>
                </div>
            }
           
            else if (Model.Status != MatchStatus.Scheduled || Model.Date <= DateTime.UtcNow)
            {
                <div class="alert alert-warning text-center">
                    ⛔ Este partido ya no acepta más apuestas (En juego o Finalizado).
                </div>
            }
            else
            {
                <!-- Panel del Apostador -->
                <div class="card shadow-sm border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Hacer una Apuesta</h5>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Bets" asp-action="Place" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="MatchId" value="@Model.Id" />
                            <input type="hidden" id="selectedPick" name="Pick" value="" required />

                            <div class="mb-3">
                                <label class="form-label fw-bold">Monto a apostar (FutCoins):</label>
                                <input type="number" step="100" min="100" id="betAmount" name="Amount" class="form-control form-control-lg" placeholder="Ej: 5000" required />
                            </div>

                            <label class="form-label fw-bold">Selecciona tu pronóstico:</label>
                            <div class="row g-2 mb-3">
                                <div class="col-4">
                                    <button type="button" class="btn btn-outline-primary w-100 py-3 pick-btn" data-pick="Home" data-odds="@Model.HomeOdds">
                                        <div><strong>1 (Local)</strong></div>
                                        <div class="fs-5">@Model.HomeOdds.ToString("N2")</div>
                                    </button>
                                </div>
                                <div class="col-4">
                                    <button type="button" class="btn btn-outline-primary w-100 py-3 pick-btn" data-pick="Draw" data-odds="@Model.DrawOdds">
                                        <div><strong>X (Empate)</strong></div>
                                        <div class="fs-5">@Model.DrawOdds.ToString("N2")</div>
                                    </button>
                                </div>
                                <div class="col-4">
                                    <button type="button" class="btn btn-outline-primary w-100 py-3 pick-btn" data-pick="Away" data-odds="@Model.AwayOdds">
                                        <div><strong>2 (Visitante)</strong></div>
                                        <div class="fs-5">@Model.AwayOdds.ToString("N2")</div>
                                    </button>
                                </div>
                            </div>

                            <div id="payoutPreview" class="alert alert-light border d-none text-center">
                                Ganancia Potencial: <strong id="potentialWin" class="text-success fs-5">$0</strong>
                            </div>

                            <button type="submit" id="submitBet" class="btn btn-success btn-lg w-100" disabled>
                                Confirmar Apuesta
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const pickButtons = document.querySelectorAll('.pick-btn');
        const pickInput = document.getElementById('selectedPick');
        const amountInput = document.getElementById('betAmount');
        const submitBtn = document.getElementById('submitBet');
        const payoutPreview = document.getElementById('payoutPreview');
        const potentialWinText = document.getElementById('potentialWin');

        let currentOdds = 0;

        pickButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                pickButtons.forEach(b => b.classList.remove('btn-primary', 'text-white'));
                pickButtons.forEach(b => b.classList.add('btn-outline-primary'));

                this.classList.remove('btn-outline-primary');
                this.classList.add('btn-primary', 'text-white');

                pickInput.value = this.dataset.pick;
                currentOdds = parseFloat(this.dataset.odds);

                updateCalculation();
            });
        });

        amountInput.addEventListener('input', updateCalculation);

        function updateCalculation() {
            const amount = parseFloat(amountInput.value) || 0;
            if (pickInput.value !== "" && amount > 0) {
                submitBtn.disabled = false;
                const win = amount * currentOdds;
                potentialWinText.innerText = "$" + win.toLocaleString('es-CO', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
                payoutPreview.classList.remove('d-none');
            } else {
                submitBtn.disabled = true;
                payoutPreview.classList.add('d-none');
            }
        }
    </script>
}